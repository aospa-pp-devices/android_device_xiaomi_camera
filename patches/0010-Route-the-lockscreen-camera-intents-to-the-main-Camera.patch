From: NurKeinNeid <nurkeinneid@derpfest.org>
Subject: Route the lockscreen camera intents to the main Camera

AssistantCamera (the voice-assistant trampoline) also handled
STILL_IMAGE_CAMERA and STILL_IMAGE_CAMERA_SECURE with the DEFAULT
category, so the lockscreen camera affordance intent resolved to two
activities and the resolver ("Complete action using Camera") appeared
after the keyguard dismissal.

Drop the two lockscreen intent-filters from AssistantCamera and give
STILL_IMAGE_CAMERA to the main Camera activity, so both lockscreen
intents resolve to the main Camera alone.

---
diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index 4e069f33..87cd9227 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -165,6 +165,7 @@
             </intent-filter>
             <intent-filter>
                 <action android:name="android.media.action.STILL_IMAGE_CAMERA_SECURE"/>
+                <action android:name="android.media.action.STILL_IMAGE_CAMERA"/>
                 <category android:name="android.intent.category.DEFAULT"/>
             </intent-filter>
             <intent-filter>
@@ -237,16 +238,8 @@
             <property android:name="miui.blurChanged" android:value="true"/>
         </activity>
         <activity android:exported="true" android:label="@string/fbk" android:name="com.android.camera.AssistantCamera" android:screenOrientation="portrait">
-            <intent-filter>
-                <action android:name="android.media.action.STILL_IMAGE_CAMERA"/>
-                <category android:name="android.intent.category.DEFAULT"/>
-                <category android:name="android.intent.category.VOICE"/>
-            </intent-filter>
-            <intent-filter>
-                <action android:name="android.media.action.STILL_IMAGE_CAMERA_SECURE"/>
-                <category android:name="android.intent.category.DEFAULT"/>
-                <category android:name="android.intent.category.VOICE"/>
-            </intent-filter>
+            
+            
         </activity>
         <meta-data android:name="com.hyperos.AI_ACTION_DESCRIPTION" android:resource="@raw/ddf"/>
         <provider android:authorities="com.android.camera.agentProvider" android:exported="true" android:name="com.android.camera.provider.CameraAgentProvider">
